# انسخ هذا الملف إلى .env للاستخدام المحلي، وعدّل القيمة محليًا. لا تضع بيانات إنتاج هنا.
POSTGRES_DB=hardware_store
POSTGRES_USER=hardware_store
POSTGRES_PASSWORD=replace-with-a-local-development-password
APP_DB_PASSWORD=replace-with-a-different-local-development-password
POSTGRES_PORT=5433
API_PORT=8080
WEB_PORT=3000

# Production only. Leave blank locally; Development uses the in-memory email provider.
# Supply these values through the deployment secret store, never commit real credentials.
# IDENTITY_EMAIL_SMTP_HOST=
# IDENTITY_EMAIL_SMTP_PORT=587
# IDENTITY_EMAIL_SMTP_ENABLE_SSL=true
# IDENTITY_EMAIL_SMTP_FROM_ADDRESS=
# IDENTITY_EMAIL_SMTP_FROM_NAME=HARDWARE STORE
# IDENTITY_EMAIL_SMTP_USERNAME=
# IDENTITY_EMAIL_SMTP_PASSWORD=

# End-to-end tests (Playwright, local only): the web app, the API's Preview__BootstrapKey and the seeded owner.
E2E_BASE_URL=http://localhost:3000
E2E_PREVIEW_KEY=replace-with-the-local-preview-bootstrap-key
E2E_OWNER_EMAIL=owner@example.com
