{
  "name": "@rigx/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed client for the RIGX API, generated from openapi.v1.json (the backend contract).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.v1.json --output src/generated/schema.d.ts",
    "prepare": "npm run generate",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
