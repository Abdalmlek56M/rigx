# RIGX production settings. On the server: cp deploy/production.env.example deploy/.env, then fill it there.
# deploy/.env is git-ignored. Never paste these values in a chat, an issue or a commit.

SITE_URL=https://rigxhardware.com

# Database (long random values: openssl rand -hex 24)
POSTGRES_DB=rigx
POSTGRES_USER=rigx
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Loopback ports host nginx proxies to (must match deploy/nginx/rigxhardware.com.conf and be free: sudo ss -tlnp)
API_PORT=8081
WEB_PORT=3001
# Private Docker network for RIGX; must not overlap another network (docker network inspect $(docker network ls -q))
RIGX_SUBNET=172.29.208.0/24
RIGX_GATEWAY=172.29.208.1

# Data Protection certificate (sign-in cookies survive restarts): made once on the server, see the launch runbook
DATAPROTECTION_CERT_FILE=/srv/rigx/secrets/dataprotection.pfx
DATAPROTECTION_CERT_PASSWORD=

# Daily backups land here, then rclone copies them to Google Drive (deploy/offsite-backup.sh)
BACKUP_DIR=/srv/rigx/backups

# Sign-in emails: Gmail SMTP with an App Password (2-step verification must be on)
SMTP_USERNAME=rigxhardware@gmail.com
SMTP_APP_PASSWORD=
# Brevo instead of Gmail (after the domain is verified in Brevo): SMTP_USERNAME = the Brevo SMTP login,
# SMTP_APP_PASSWORD = the Brevo SMTP key, and:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_FROM=no-reply@rigxhardware.com

# Google sign-in: the production OAuth client id (public; no client secret is used)
GOOGLE_CLIENT_ID=

# Sentry (free Developer plan): one DSN per project
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# Google Analytics 4 measurement id (G-XXXXXXX) and Meta pixel id; empty = not loaded
GA_ID=
META_PIXEL_ID=
