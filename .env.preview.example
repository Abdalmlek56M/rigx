# Copy to .env.preview.local and replace every placeholder locally.
# .env.preview.local is ignored by Git and must never be committed or archived.
PREVIEW_DB_PORT=5435
PREVIEW_API_PORT=8085
PREVIEW_WEB_PORT=3005
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3005
# Owner-supplied business number only. Leave empty until approved.
STORE_WHATSAPP_NUMBER=

POSTGRES_DB=hardware_store_preview
POSTGRES_USER=hardware_store_preview_owner
POSTGRES_PASSWORD=replace-with-a-unique-preview-owner-password
APP_DB_PASSWORD=replace-with-a-different-preview-app-password

PREVIEW_OWNER_EMAIL=owner@example.test
PREVIEW_OWNER_USERNAME=preview-owner
PREVIEW_OWNER_FULL_NAME=Preview Owner
PREVIEW_OWNER_PASSWORD=replace-with-a-unique-owner-login-password
PREVIEW_BOOTSTRAP_KEY=replace-with-a-random-one-time-bootstrap-key
